 model Report {
  reason    String
  status    ReportStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  reporterId String
  reporter   User   @relation("UserReports", fields: [reporterId], references: [clerkId], onDelete: NoAction)

  entityType ReportEntityType
  entityId   String

  @@id([reporterId, entityType, entityId])
  @@index([reporterId])
  @@index([entityType, entityId])
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum ReportEntityType {
  TALK
  ARTICLE
}

