model ClimbingSpotComment {
  content   String
  notation  Int       @default(0)   
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  
  // Relations avec ClimbingSpot et User
  climbingSpotId    String
  climbingSpot      ClimbingSpot      @relation(fields: [climbingSpotId], references: [id], onDelete: Cascade)
  authorId  String      
  author    User        @relation(fields: [authorId], references: [clerkId], onDelete: NoAction)

  @@unique([climbingSpotId, authorId])
  @@index([climbingSpotId])
  @@index([authorId])
}


